<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Quotation</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: Arial, sans-serif;
      font-size: 11px;
      color: #222;
      background: #fff;
      padding: 24px 28px;
    }

    /* ── HEADER ── */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 12px;
      border-bottom: 2px solid #222;
      padding-bottom: 12px;
    }
    .header-logo img {
      max-width: 120px;
      max-height: 80px;
      object-fit: contain;
    }
    .header-company {
      text-align: right;
      max-width: 55%;
    }
    .header-company h1 {
      font-size: 15px;
      font-weight: bold;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .header-company p {
      font-size: 10px;
      line-height: 1.5;
      color: #333;
    }

    /* ── DOC TITLE ── */
    .doc-title {
      text-align: center;
      font-size: 12px;
      font-style: italic;
      color: #444;
      border-bottom: 1px solid #ccc;
      border-top: 1px solid #ccc;
      padding: 6px 0;
      margin-bottom: 14px;
    }

    /* ── ESTIMATE SECTION ── */
    .estimate-section {
      display: flex;
      justify-content: space-between;
      margin-bottom: 14px;
      border-bottom: 1px solid #ccc;
      padding-bottom: 12px;
    }
    .estimate-for {
      width: 50%;
    }
    .estimate-for .label,
    .estimate-details .label {
      font-size: 11px;
      font-weight: bold;
      margin-bottom: 5px;
    }
    .estimate-for .company-name {
      font-weight: bold;
      font-size: 11.5px;
    }
    .estimate-for p {
      font-size: 10.5px;
      line-height: 1.6;
    }
    .estimate-details {
      width: 46%;
      text-align: right;
    }
    .estimate-details table {
      width: 100%;
      font-size: 10.5px;
    }
    .estimate-details table td {
      padding: 1px 2px;
      line-height: 1.6;
    }
    .estimate-details table td:first-child {
      text-align: right;
      color: #555;
    }
    .estimate-details table td:last-child {
      text-align: right;
      font-weight: bold;
    }

    /* ── ITEMS TABLE ── */
    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 14px;
      font-size: 10.5px;
    }
    .items-table th {
      background: #e8e8e8;
      border: 1px solid #bbb;
      padding: 5px 6px;
      text-align: center;
      font-weight: bold;
      font-size: 10px;
    }
    .items-table td {
      border: 1px solid #ccc;
      padding: 5px 6px;
      vertical-align: top;
    }
    .items-table td.num { text-align: center; }
    .items-table td.right { text-align: right; }
    .items-table td.center { text-align: center; }
    .items-table tr.total-row td {
      font-weight: bold;
      background: #f7f7f7;
      border-top: 2px solid #aaa;
    }

    /* ── BOTTOM SECTION: TAX + AMOUNTS ── */
    .bottom-section {
      display: flex;
      gap: 16px;
      margin-bottom: 14px;
      align-items: flex-start;
    }
    .tax-table-wrap { width: 52%; }
    .amounts-wrap { width: 46%; }

    .tax-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 10.5px;
    }
    .tax-table th {
      background: #e8e8e8;
      border: 1px solid #bbb;
      padding: 5px 6px;
      font-size: 10px;
    }
    .tax-table td {
      border: 1px solid #ccc;
      padding: 5px 6px;
      text-align: right;
    }
    .tax-table td:first-child { text-align: left; }

    .amounts-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 10.5px;
    }
    .amounts-table th {
      background: #e8e8e8;
      border: 1px solid #bbb;
      padding: 5px 8px;
      text-align: left;
      font-size: 10px;
    }
    .amounts-table td {
      border: 1px solid #ccc;
      padding: 5px 8px;
    }
    .amounts-table td:last-child { text-align: right; }
    .amounts-table tr.total-row td { font-weight: bold; }

    /* ── GRAY SECTION HEADER ── */
    .section-header {
      background: #d5d5d5;
      padding: 5px 8px;
      font-size: 10.5px;
      font-weight: bold;
      margin-bottom: 6px;
      margin-top: 12px;
      border-radius: 0;
    }
    .section-text {
      font-size: 10.5px;
      line-height: 1.7;
      padding: 0 4px;
      margin-bottom: 6px;
      white-space: pre-wrap;
    }

    /* ── BANK DETAILS ── */
    .bank-details p {
      font-size: 10.5px;
      line-height: 1.8;
      padding: 0 4px;
    }

    /* ── SIGNATURE ── */
    .signature-section {
      text-align: right;
      margin-top: -60px;
      padding-right: 4px;
    }
    .signature-section .for-company {
      font-size: 10.5px;
      margin-bottom: 6px;
    }
    .signature-section img {
      max-height: 60px;
      max-width: 150px;
      display: block;
      margin-left: auto;
      margin-bottom: 4px;
    }
    .signature-section .sig-line {
      border-top: 1px solid #333;
      width: 160px;
      margin-left: auto;
      margin-bottom: 4px;
    }
    .signature-section .authorized {
      font-size: 10.5px;
      font-weight: bold;
    }

    /* ── FOOTER WRAP ── */
    .footer-row {
      display: flex;
      gap: 20px;
      margin-top: 12px;
    }
    .footer-left { width: 55%; }
    .footer-right { width: 45%; }
  </style>
</head>
<body>

  <!-- HEADER -->
  <div class="header">
    <div class="header-logo">
      {{#if logoUrl}}
        <img src="{{logoUrl}}" alt="Company Logo" />
      {{/if}}
    </div>
    <div class="header-company">
      <h1>{{companyName}}</h1>
      <p>{{companyAddress}}</p>
      <p>Phone no.: {{companyPhone}} Email: {{companyEmail}}</p>
      <p>GSTIN: {{companyGstin}}, State: {{companyState}}</p>
      <p>PAN: {{companyPan}}</p>
    </div>
  </div>

  <!-- TITLE -->
  <div class="doc-title">Quotation</div>

  <!-- ESTIMATE FOR / DETAILS -->
  <div class="estimate-section">
    <div class="estimate-for">
      <div class="label">Estimate For</div>
      <div class="company-name">{{clientCompanySnapshot}}</div>
      <p>{{customer.billingStreet1}}{{#if customer.billingStreet2}}, {{customer.billingStreet2}}{{/if}}</p>
      <p>{{customer.billingCity}}{{#if customer.billingZipCode}}-{{customer.billingZipCode}}{{/if}}</p>
      <p>Contact No. : {{customer.workPhone}}{{#unless customer.workPhone}}{{customer.mobilePhone}}{{/unless}}</p>
      <p>State: {{customer.billingState}}</p>
    </div>
    <div class="estimate-details">
      <div class="label">Estimate Details</div>
      <table>
        <tr>
          <td>Estimate No. :</td>
          <td>{{quoteNumber}}</td>
        </tr>
        <tr>
          <td>Date :</td>
          <td>{{quoteDate}}</td>
        </tr>
        <tr>
          <td>Place of supply:</td>
          <td>{{customer.billingState}}</td>
        </tr>
        <tr>
          <td>Name:</td>
          <td>{{salesperson}}</td>
        </tr>
        <tr>
          <td>Email:</td>
          <td>{{salespersonEmail}}</td>
        </tr>
        <tr>
          <td>Mobile:</td>
          <td>{{salespersonMobile}}</td>
        </tr>
        <tr>
          <td>Valid till:</td>
          <td>{{expiryDate}}</td>
        </tr>
      </table>
    </div>
  </div>

  <!-- ITEMS TABLE -->
  <table class="items-table">
    <thead>
      <tr>
        <th style="width:28px">#</th>
        <th style="text-align:left">Item name</th>
        <th>HSN/SAC</th>
        <th>Quantity</th>
        <th>Unit</th>
        <th>Price/ Unit</th>
        <th>Taxable amount</th>
        <th>GST</th>
        <th>Amount</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td class="num">{{index}}</td>
        <td><strong>{{name}}</strong>{{#if description}}<br/><span style="color:#555;font-size:9.5px">{{description}}</span>{{/if}}</td>
        <td class="center">{{hsn}}</td>
        <td class="center">{{quantity}}</td>
        <td class="center">{{unit}}</td>
        <td class="right">₹ {{rate}}</td>
        <td class="right">₹ {{taxableAmount}}</td>
        <td class="center">₹ {{taxAmount}}<br/>[{{tax}}%]</td>
        <td class="right">₹ {{amount}}</td>
      </tr>
      {{/each}}
      <tr class="total-row">
        <td colspan="3">Total</td>
        <td class="center">{{totalQuantity}}</td>
        <td></td>
        <td></td>
        <td class="right">₹ {{subTotal}}</td>
        <td class="right">₹ {{totalTax}}</td>
        <td class="right">₹ {{totalAmount}}</td>
      </tr>
    </tbody>
  </table>

  <!-- TAX SUMMARY + AMOUNTS -->
  <div class="bottom-section">
    <div class="tax-table-wrap">
      <table class="tax-table">
        <thead>
          <tr>
            <th style="text-align:left">Tax type</th>
            <th>Taxable amount</th>
            <th>Rate</th>
            <th>Tax amount</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>SGST</td>
            <td>₹ {{subTotal}}</td>
            <td>9%</td>
            <td>₹ {{sgst}}</td>
          </tr>
          <tr>
            <td>CGST</td>
            <td>₹ {{subTotal}}</td>
            <td>9%</td>
            <td>₹ {{cgst}}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="amounts-wrap">
      <table class="amounts-table">
        <thead>
          <tr>
            <th colspan="2">Amounts</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Sub Total</td>
            <td>₹ {{subTotal}}</td>
          </tr>
          <tr class="total-row">
            <td>Total</td>
            <td>₹ {{totalAmount}}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- AMOUNT IN WORDS -->
  <div class="section-header">Estimate Amount In Words</div>
  <div class="section-text">{{totalAmountInWords}}</div>

  <!-- FOOTER ROW: Terms + Signature -->
  <div class="footer-row">
    <div class="footer-left">
      {{#if termsConditions}}
        <div class="section-header" style="margin-top:10px">Terms and Conditions</div>
        <div class="section-text">{{termsConditions}}</div>
      {{/if}}

      <div class="section-header" style="margin-top:10px">Bank Details</div>
      <div class="bank-details">
        <p>Name : {{bankName}}</p>
        <p>Account No. : {{bankAccountNo}}</p>
        <p>IFSC code : {{bankIfsc}}</p>
        <p>Account holder's name : {{bankAccountHolder}}</p>
      </div>
    </div>
    <div class="footer-right">
      <div class="signature-section">
        <p class="for-company">for : {{companyName}}</p>
        {{#if signatureUrl}}
          <img src="{{signatureUrl}}" alt="Signature" />
        {{else}}
          <div style="height:55px"></div>
        {{/if}}
        <div class="sig-line"></div>
        <p class="authorized">Authorized Signatory</p>
      </div>
    </div>
  </div>

</body>
</html>
