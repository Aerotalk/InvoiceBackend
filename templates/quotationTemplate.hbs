<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Quotation</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: Arial, sans-serif;
      font-size: 10px;
      color: #000;
      background: #fff;
      padding: 10px 15px;
      line-height: 1.3;
    }

    /* ── HEADER ── */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 8px;
      padding-bottom: 8px;
    }
    .header-logo img {
      height: 60px;
      width: auto;
      object-fit: contain;
    }
    .header-company {
      text-align: right;
      max-width: 65%;
    }
    .header-company h1 {
      font-size: 13.5px;
      font-weight: bold;
      text-transform: uppercase;
      margin-bottom: 3px;
      letter-spacing: 0.5px;
    }
    .header-company p {
      font-size: 9px;
      line-height: 1.3;
      color: #111;
    }

    /* ── DOC TITLE BAR ── */
    .doc-title-bar {
      text-align: center;
      background: #f4f4f5;
      border-top: 1px solid #ccc;
      border-bottom: 1px solid #ccc;
      padding: 4px 0;
      margin-bottom: 12px;
    }
    .doc-title-bar span {
      font-size: 12px;
      font-weight: bold;
      color: #555;
    }

    /* ── ESTIMATE SECTION (2 COLUMNS) ── */
    .estimate-section {
      display: flex;
      justify-content: space-between;
      margin-bottom: 12px;
      gap: 15px;
    }
    .estimate-col {
      width: 48%;
    }
    .col-title {
      font-size: 10px;
      font-weight: bold;
      color: #000;
      border-bottom: 1px solid #ccc;
      padding-bottom: 3px;
      margin-bottom: 5px;
    }
    .col-company {
      font-weight: bold;
      font-size: 9.5px;
      margin-bottom: 3px;
      text-transform: uppercase;
    }
    .col-text {
      font-size: 9px;
      line-height: 1.35;
      color: #222;
    }
    .col-text strong {
      font-weight: bold;
      color: #000;
    }

    /* ── ESTIMATE DETAILS TABLE ── */
    .details-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9px;
    }
    .details-table td {
      padding: 1.5px 0;
      vertical-align: top;
      line-height: 1.25;
    }
    .details-table td.lbl {
      text-align: right;
      padding-right: 4px;
      color: #222;
      width: 45%;
    }
    .details-table td.val {
      text-align: right;
      font-weight: bold;
      color: #000;
      width: 55%;
    }

    /* ── ITEMS TABLE ── */
    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12px;
      font-size: 9px;
    }
    .items-table th {
      background: #8e99a7;
      color: #fff;
      border: 1px solid #7c8ba1;
      padding: 4px 6px;
      font-weight: bold;
      font-size: 8.5px;
      text-align: center;
    }
    .items-table th.left { text-align: left; }
    .items-table th.right { text-align: right; }
    .items-table td {
      border: 1px solid #ccc;
      padding: 5px 6px;
      vertical-align: top;
      line-height: 1.25;
    }
    .items-table td.num { text-align: center; width: 25px; }
    .items-table td.center { text-align: center; }
    .items-table td.right { text-align: right; }
    .items-table tr.total-row td {
      font-weight: bold;
      border-top: 1.5px solid #000;
      border-bottom: 1.5px solid #000;
      background: #fff;
    }

    /* ── BOTTOM SUMMARY ── */
    .bottom-summary {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 12px;
    }
    .tax-summary-wrap {
      width: 55%;
    }
    .amounts-summary-wrap {
      width: 42%;
    }
    .summary-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9px;
    }
    .summary-table th {
      background: #9ca3af;
      color: #fff;
      padding: 3px 6px;
      font-weight: bold;
      font-size: 8.5px;
      text-align: right;
    }
    .summary-table th.left { text-align: left; }
    .summary-table td {
      border: 1px solid #ccc;
      padding: 4px 6px;
      text-align: right;
    }
    .summary-table td.left { text-align: left; }
    .summary-table tr.total-row td {
      font-weight: bold;
    }

    /* ── SECTION HEADER BAR ── */
    .bar-header {
      background: #9ca3af;
      color: #fff;
      padding: 3px 6px;
      font-weight: bold;
      font-size: 9px;
      margin-bottom: 4px;
      text-transform: uppercase;
    }
    .bar-content {
      font-size: 9px;
      line-height: 1.35;
      padding-left: 2px;
      margin-bottom: 12px;
    }

    /* ── PAGE BREAK ── */
    .page-break {
      page-break-before: always;
    }

    /* ── FOOTER ROW ── */
    .footer-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-top: 10px;
    }
    .footer-col {
      width: 65%;
    }
    .footer-company-col {
      width: 32%;
      text-align: right;
    }
    .for-company {
      font-size: 9.5px;
      font-weight: bold;
      margin-bottom: 4px;
    }
    .signature-wrap {
      height: 60px;
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
      margin-bottom: 4px;
    }
    .signature-wrap img {
      max-height: 55px;
      max-width: 130px;
      object-fit: contain;
    }
  </style>
</head>
<body>

  <!-- ==================== PAGE 1 ==================== -->
  <!-- HEADER -->
  <div class="header">
    <div class="header-logo">
      {{#if logoUrl}}
        <img src="{{logoUrl}}" alt="Company Logo" />
      {{/if}}
    </div>
    <div class="header-company">
      <h1>{{companyName}}</h1>
      <p>{{companyAddress}}</p>
      <p>Phone no.: {{companyPhone}} Email: {{companyEmail}}</p>
      <p>GSTIN: {{companyGstin}}, State: {{companyState}}</p>
      <p>PAN: {{companyPan}}</p>
    </div>
  </div>

  <!-- TITLE BAR -->
  <div class="doc-title-bar">
    <span>Quotation</span>
  </div>

  <!-- DETAILS GRID -->
  <div class="estimate-section">
    <!-- Col 1 -->
    <div class="estimate-col">
      <div class="col-title">Estimate For</div>
      <div class="col-company">{{clientCompanySnapshot}}</div>
      <div class="col-text">
        {{customer.billingStreet1}}{{#if customer.billingStreet2}}, {{customer.billingStreet2}}{{/if}}
        <br/>{{customer.billingCity}}{{#if customer.billingState}}, {{customer.billingState}}{{/if}}{{#if customer.billingZipCode}} - {{customer.billingZipCode}}{{/if}}
        {{#if customer.billingCountry}}<br/>{{customer.billingCountry}}{{/if}}
        <br/>Contact No. : {{customer.workPhone}}{{#unless customer.workPhone}}{{customer.mobilePhone}}{{/unless}}
        <br/>State: {{customer.billingState}}
      </div>
    </div>
    <!-- Col 2 -->
    <div class="estimate-col">
      <div class="col-title">Estimate Details</div>
      <table class="details-table">
        <tr>
          <td class="lbl">Estimate No. :</td>
          <td class="val">{{quoteNumber}}</td>
        </tr>
        <tr>
          <td class="lbl">Date :</td>
          <td class="val">{{quoteDate}}</td>
        </tr>
        <tr>
          <td class="lbl">Place of supply:</td>
          <td class="val">{{customer.billingState}}</td>
        </tr>
        <tr>
          <td class="lbl">Name:</td>
          <td class="val">{{salespersonName}}</td>
        </tr>
        <tr>
          <td class="lbl">Email:</td>
          <td class="val" style="font-weight: normal; font-size: 8.5px;">{{salespersonEmail}}</td>
        </tr>
        <tr>
          <td class="lbl">Mobile:</td>
          <td class="val">{{salespersonMobile}}</td>
        </tr>
        {{#if expiryDate}}
        <tr>
          <td class="lbl">Valid till:</td>
          <td class="val">{{expiryDate}}</td>
        </tr>
        {{/if}}
      </table>
    </div>
  </div>

  <!-- ITEMS TABLE -->
  <table class="items-table">
    <thead>
      <tr>
        <th style="width: 28px;">#</th>
        <th class="left">Item name</th>
        <th style="width: 70px;">HSN/ SAC</th>
        <th style="width: 50px;">Quantity</th>
        <th style="width: 40px;">Unit</th>
        <th style="width: 80px;" class="right">Price/ Unit</th>
        <th style="width: 85px;" class="right">Taxable amount</th>
        <th style="width: 85px;" class="right">GST</th>
        <th style="width: 85px;" class="right">Amount</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td class="num">{{index}}</td>
        <td>
          <strong>{{name}}</strong>
          {{#if description}}
            <br/><span style="color:#333; font-size: 8px; font-weight: normal; line-height: 1.25; display: inline-block; margin-top: 2px;">{{description}}</span>
          {{/if}}
        </td>
        <td class="center">{{hsn}}</td>
        <td class="center">{{quantity}}</td>
        <td class="center">{{unit}}</td>
        <td class="right">₹ {{rate}}</td>
        <td class="right">₹ {{taxableAmount}}</td>
        <td class="right">₹ {{taxAmount}}<br/>({{tax}}%)</td>
        <td class="right">₹ {{amount}}</td>
      </tr>
      {{/each}}
      <tr class="total-row">
        <td colspan="3">Total</td>
        <td class="center">{{totalQuantity}}</td>
        <td></td>
        <td></td>
        <td class="right">₹ {{subTotal}}</td>
        <td class="right">₹ {{totalTax}}</td>
        <td class="right">₹ {{totalAmount}}</td>
      </tr>
    </tbody>
  </table>

  <!-- BOTTOM GRIDS -->
  <div class="bottom-summary">
    <!-- Left: Tax Table -->
    <div class="tax-summary-wrap">
      <table class="summary-table">
        <thead>
          <tr>
            <th class="left">Tax type</th>
            <th>Taxable amount</th>
            <th>Rate</th>
            <th>Tax amount</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="left">SGST</td>
            <td>₹ {{subTotal}}</td>
            <td>9%</td>
            <td>₹ {{sgst}}</td>
          </tr>
          <tr>
            <td class="left">CGST</td>
            <td>₹ {{subTotal}}</td>
            <td>9%</td>
            <td>₹ {{cgst}}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <!-- Right: Amounts Table -->
    <div class="amounts-summary-wrap">
      <table class="summary-table">
        <thead>
          <tr>
            <th colspan="2" class="left">Amounts</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="left" style="border: 1px solid #ccc;">Sub Total</td>
            <td style="border: 1px solid #ccc;">₹ {{totalAmount}}</td>
          </tr>
          <tr class="total-row">
            <td class="left" style="border: 1px solid #ccc;">Total</td>
            <td style="border: 1px solid #ccc;">₹ {{totalAmount}}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- AMOUNT IN WORDS -->
  <div class="bar-header">Estimate Amount In Words</div>
  <div class="bar-content" style="font-weight: bold; margin-bottom: 0;">
    {{totalAmountInWords}}
  </div>


  <!-- ==================== PAGE 2 ==================== -->
  <div class="page-break"></div>

  <!-- HEADER -->
  <div class="header">
    <div class="header-logo">
      {{#if logoUrl}}
        <img src="{{logoUrl}}" alt="Company Logo" />
      {{/if}}
    </div>
    <div class="header-company">
      <h1>{{companyName}}</h1>
      <p>{{companyAddress}}</p>
      <p>Phone no.: {{companyPhone}} Email: {{companyEmail}}</p>
      <p>GSTIN: {{companyGstin}}, State: {{companyState}}</p>
      <p>PAN: {{companyPan}}</p>
    </div>
  </div>

  <!-- TERMS AND CONDITIONS -->
  <div class="bar-header" style="margin-top: 8px;">Terms and Conditions</div>
  <div class="bar-content" style="line-height: 1.45; color: #111;">
    <ol style="padding-left: 14px; list-style-type: decimal; font-size: 8.5px;">
      <li><strong>Validity of Quotation:</strong> This quotation is valid for the period mentioned above in the proposal.</li>
      <li style="margin-top: 2px;"><strong>Pricing :</strong> All prices are quoted in INR. GST and applicable taxes are mentioned above and will be charged as applicable.</li>
      <li style="margin-top: 2px;"><strong>Payment Terms:</strong> 100% advanced Payment, Payment can be made via bank transfer, cheque, or any other mutually agreed mode.</li>
      <li style="margin-top: 2px;"><strong>Delivery Timeline :</strong> Standard delivery time is 7 to 10 working days from the date of confirmed order.</li>
      <li style="margin-top: 2px;"><strong>Installation & Commissioning:</strong> Installation will be carried out by Grivety Global Private Limited.<br/>Any additional electrical, civil, or network-related work at the customer site is not included, unless specifically mentioned.</li>
      <li style="margin-top: 2px;"><strong>Warranty :</strong> Standard manufacturer warranty: Warranty covers manufacturing defects only.<br/>Physical damage, mishandling, or unauthorized repairs are not covered.</li>
      <li style="margin-top: 2px;"><strong>Order Placement Address</strong><br/>
        Grivety Global Pvt. Ltd.<br/>
        DISHA Apartment, Flat No. 2, Ground Floor, DA - 4/13, Deshbandhu Nagar<br/>
        Joramondir, Baguiati, VIP Road<br/>
        Kolkata - 700 059
      </li>
    </ol>
    {{#if termsConditions}}
      <div style="white-space: pre-wrap; font-size: 8.5px; margin-top: 6px; border-top: 1px dashed #ccc; padding-top: 4px;">{{termsConditions}}</div>
    {{/if}}
  </div>

  <!-- BANK DETAILS -->
  <div class="bar-header">Bank Details</div>
  <div class="bar-content" style="line-height: 1.5; padding-left: 4px; font-size: 8.5px;">
    <div><strong>Name :</strong> {{bankName}}</div>
    <div><strong>Account No. :</strong> {{bankAccountNo}}</div>
    <div><strong>IFSC code :</strong> {{bankIfsc}}</div>
    <div><strong>Account holder's name :</strong> {{bankAccountHolder}}</div>
  </div>

  <!-- SIGNATURE BLOCK -->
  <div class="footer-row">
    <div class="footer-col"></div>
    <div class="footer-company-col">
      <p class="for-company">For : {{companyName}}</p>
      <div class="signature-wrap">
        {{#if signatureUrl}}
          <img src="{{signatureUrl}}" alt="Signature Stamp" />
        {{/if}}
      </div>
      <p style="font-weight: bold; font-size: 9.5px; margin-top: 4px; text-align: right;">Authorized Signatory</p>
    </div>
  </div>

</body>
</html>
