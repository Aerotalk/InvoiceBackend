<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Purchase Order</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      font-size: 10px;
      color: #000;
      background: #fff;
      padding: 10px 15px;
      line-height: 1.3;
      padding-top: 95px;
      /* leaves space for fixed header */
    }

    /* ── HEADER ── */
    .header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 80px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2px solid #ddd;
      padding-bottom: 8px;
      background: #fff;
      z-index: 1000;
    }

    .header-logo img {
      height: 60px;
      width: auto;
      object-fit: contain;
    }

    .header-company {
      text-align: right;
      max-width: 65%;
    }

    .header-company h1 {
      font-size: 13.5px;
      font-weight: bold;
      text-transform: uppercase;
      margin-bottom: 3px;
      letter-spacing: 0.5px;
    }

    .header-company p {
      font-size: 9px;
      line-height: 1.3;
      color: #111;
    }

    /* ── DOC TITLE BAR ── */
    .doc-title-bar {
      text-align: center;
      background: #f4f4f5;
      border-top: 1px solid #ccc;
      border-bottom: 1px solid #ccc;
      padding: 4px 0;
      margin-bottom: 12px;
      border-radius: 4px;
    }

    .doc-title-bar span {
      font-size: 12px;
      font-weight: bold;
      color: #555;
      text-transform: uppercase;
    }

    /* ── INFO SECTION ── */
    .info-section {
      display: flex;
      justify-content: space-between;
      margin-bottom: 12px;
      gap: 12px;
      break-inside: avoid;
    }

    .info-col {
      /* Width set inline */
    }

    .col-title {
      font-size: 10px;
      font-weight: bold;
      color: #000;
      border-bottom: 1.5px solid #ccc;
      padding-bottom: 3px;
      margin-bottom: 5px;
      text-transform: uppercase;
    }

    .col-company {
      font-weight: bold;
      font-size: 9.5px;
      margin-bottom: 3px;
      text-transform: uppercase;
    }

    .col-text {
      font-size: 9px;
      line-height: 1.35;
      color: #222;
    }

    .col-text strong {
      font-weight: bold;
      color: #000;
    }

    /* ── DETAILS TABLE ── */
    .details-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9px;
    }

    .details-table td {
      padding: 1.5px 0;
      vertical-align: top;
      line-height: 1.25;
    }

    .details-table td.lbl {
      text-align: left;
      color: #222;
      width: 45%;
    }

    .details-table td.val {
      text-align: right;
      font-weight: bold;
      color: #000;
      width: 55%;
    }

    /* ── ITEMS TABLE ── */
    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12px;
      font-size: 9.5px;
    }

    .items-table th {
      background: #949494;
      color: #fff;
      border-top: 1px solid #7c8ba1;
      border-bottom: 1px solid #7c8ba1;
      padding: 5px 6px;
      font-weight: bold;
      font-size: 9px;
      text-align: center;
    }

    .items-table th.left {
      text-align: left;
    }

    .items-table td {
      border-bottom: 1px solid #ddd;
      padding: 6px;
      vertical-align: top;
      line-height: 1.3;
    }

    .items-table td.num {
      text-align: center;
    }

    .items-table td.center {
      text-align: center;
    }

    .items-table td.right {
      text-align: right;
    }

    .items-table tr.total-row td {
      font-weight: bold;
      border-top: 1.5px solid #000;
      border-bottom: 1.5px solid #000;
      background: #fff;
    }

    tr {
      break-inside: avoid;
    }

    thead {
      display: table-header-group;
    }

    /* ── BOTTOM SUMMARY ── */
    .bottom-section {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 12px;
      break-inside: avoid;
    }

    .left-summary {
      width: 55%;
    }

    .right-summary {
      width: 42%;
    }

    .summary-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9px;
      margin-bottom: 10px;
    }

    .summary-table th {
      background: #949494;
      color: #fff;
      padding: 3px 6px;
      font-weight: bold;
      font-size: 8.5px;
      text-align: right;
      border: 1px solid #949494;
    }

    .summary-table th.left {
      text-align: left;
    }

    .summary-table td {
      border: 1px solid #ccc;
      padding: 4px 6px;
      text-align: right;
    }

    .summary-table td.left {
      text-align: left;
    }

    .summary-table tr.total-row td {
      font-weight: bold;
    }

    .bar-header {
      background: #949494;
      color: #fff;
      padding: 3px 6px;
      font-weight: bold;
      font-size: 9px;
      margin-bottom: 4px;
      text-transform: uppercase;
      border-radius: 2px;
    }

    .bar-content {
      font-size: 9px;
      line-height: 1.35;
      padding-left: 2px;
      margin-bottom: 10px;
      color: #222;
    }

    /* ── FOOTER ROW ── */
    .footer-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-top: 15px;
      break-inside: avoid;
    }

    .footer-company-col {
      width: 50%;
      text-align: right;
    }

    .for-company {
      font-size: 9.5px;
      font-weight: bold;
      margin-bottom: 4px;
    }

    .signature-wrap {
      height: 60px;
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
      margin-bottom: 4px;
    }

    .signature-wrap img {
      max-height: 55px;
      max-width: 130px;
      object-fit: contain;
    }
  </style>
</head>

<body>

  <!-- HEADER -->
  <div class="header">
    <div class="header-logo">
      {{#if logoUrl}}
      <img src="{{logoUrl}}" alt="Company Logo" />
      {{/if}}
    </div>
    <div class="header-company">
      <h1>{{companyName}}</h1>
      <p>{{companyAddress}}</p>
      <p>Phone no.: {{companyPhone}} Email: {{companyEmail}}</p>
      <p>GSTIN: {{companyGstin}}, State: {{companyState}}</p>
      <p>PAN: {{companyPan}}</p>
    </div>
  </div>

  <!-- TITLE BAR -->
  <div class="doc-title-bar">
    <span>Purchase Order</span>
  </div>

  <!-- DETAILS GRID -->
  <div class="info-section">
    <!-- Col 1: Order To -->
    <div class="info-col" style="width: 38%;">
      <div class="col-title">Order To</div>
      <div class="col-company">{{vendorCompanySnapshot}}</div>
      <div class="col-text">
        {{#if vendor.billingStreet1}}{{vendor.billingStreet1}}<br />{{/if}}
        {{#if vendor.billingStreet2}}{{vendor.billingStreet2}}<br />{{/if}}
        {{vendor.billingCity}}{{#if vendor.billingState}}, {{vendor.billingState}}{{/if}}{{#if vendor.billingZipCode}} -
        {{vendor.billingZipCode}}{{/if}}
        {{#if vendor.billingCountry}}<br />{{vendor.billingCountry}}{{/if}}
        <br />Contact No. : {{vendor.workPhone}}{{#unless vendor.workPhone}}{{vendor.mobilePhone}}{{/unless}}
        <br />GSTIN : {{vendor.gstNumber}}
        <br />State: {{vendor.billingState}}
      </div>
    </div>

    <!-- Col 2: Transportation Details -->
    <div class="info-col" style="width: 27%;">
      <div class="col-title">Transportation Details</div>
      <div class="col-text">
        <strong>Transport Mode:</strong> {{transportMode}}
        <br /><strong style="display:inline-block; margin-top: 4px;">Delivery Location:</strong> {{deliveryLocation}}
        {{!-- <br /><strong style="display:inline-block; margin-top: 4px;">EU PO/WO Number:</strong> {{euPoWoNumber}}
        --}}
      </div>
    </div>

    <!-- Col 3: Order Details -->
    <div class="info-col" style="width: 35%;">
      <div class="col-title" style="text-align: right;">Order Details</div>
      <table class="details-table">
        <tr>
          <td class="lbl">PO/WO Number:</td>
          <td class="val">{{purchaseOrderId}}</td>
        </tr>
        <tr>
          <td class="lbl">Date :</td>
          <td class="val">{{date}}</td>
        </tr>
        <tr>
          <td class="lbl">Place of supply:</td>
          <td class="val">{{placeOfSupply}}</td>
        </tr>
        <tr>
          <td class="lbl">Due Date :</td>
          <td class="val">{{dueDate}}</td>
        </tr>
        <tr>
          <td class="lbl">Name:</td>
          <td class="val">{{contactName}}</td>
        </tr>
        <tr>
          <td class="lbl">Email:</td>
          <td class="val" style="word-break: break-all; font-weight: normal; font-size: 8.5px;">{{contactEmail}}</td>
        </tr>
        <tr>
          <td class="lbl">Mobile:</td>
          <td class="val">{{contactPhone}}</td>
        </tr>
      </table>
    </div>
  </div>

  <!-- ITEMS TABLE -->
  <table class="items-table">
    <thead>
      <tr>
        <th style="width: 30px;">#</th>
        <th class="left">Item name</th>
        <th style="width: 90px;">HSN/SAC</th>
        <th style="width: 75px;">Quantity</th>
        <th style="width: 50px;">Unit</th>
        <th style="width: 85px; text-align: right;">Price/ Unit</th>
        <th style="width: 95px; text-align: right;">Taxable amount</th>
        <th style="width: 95px; text-align: right;">GST</th>
        <th style="width: 95px; text-align: right;">Amount</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td class="num">{{index}}</td>
        <td>
          <strong>{{{name}}}</strong>
        </td>
        <td class="center">{{hsnSac}}</td>
        <td class="center">{{quantity}}</td>
        <td class="center">{{unit}}</td>
        <td class="right">₹ {{rate}}</td>
        <td class="right">₹ {{taxableAmount}}</td>
        <td class="right">₹ {{gstAmount}}<br /><span style="font-size: 8px; color: #555;">({{gstRate}}%)</span></td>
        <td class="right">₹ {{total}}</td>
      </tr>
      {{/each}}
      <tr class="total-row">
        <td colspan="3">Total</td>
        <td class="center">{{totalQuantity}}</td>
        <td></td>
        <td></td>
        <td class="right">₹ {{subTotal}}</td>
        <td class="right">₹ {{totalTax}}</td>
        <td class="right">₹ {{totalAmount}}</td>
      </tr>
    </tbody>
  </table>

  <!-- BOTTOM SECTIONS -->
  <div class="bottom-section">
    <!-- Left Side: Tax and Terms -->
    <div class="left-summary">
      <table class="summary-table">
        <thead>
          <tr>
            <th class="left" style="width: 25%;">Tax type</th>
            <th style="width: 30%;">Taxable amount</th>
            <th style="width: 15%;">Rate</th>
            <th style="width: 30%;">Tax amount</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="left">SGST</td>
            <td>₹ {{subTotal}}</td>
            <td>9%</td>
            <td>₹ {{sgst}}</td>
          </tr>
          <tr>
            <td class="left">CGST</td>
            <td>₹ {{subTotal}}</td>
            <td>9%</td>
            <td>₹ {{cgst}}</td>
          </tr>
        </tbody>
      </table>

      <div class="bar-header">Order Amount In Words</div>
      <div class="bar-content" style="font-weight: bold;">
        {{totalAmountInWords}}
      </div>

      {{#if termsAndConditions}}
      <div class="bar-header">Terms and Conditions</div>
      <div class="bar-content" style="white-space: pre-wrap;">{{termsAndConditions}}</div>
      {{/if}}
    </div>

    <!-- Right Side: Amounts Summary -->
    <div class="right-summary">
      <table class="summary-table">
        <thead>
          <tr>
            <th colspan="2" class="left">Amounts</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="left">Sub Total</td>
            <td>₹ {{rawTotal}}</td>
          </tr>
          <tr>
            <td class="left">Round off</td>
            <td>₹ {{roundOff}}</td>
          </tr>
          <tr class="total-row">
            <td class="left">Total</td>
            <td>₹ {{totalAmount}}</td>
          </tr>
          <tr>
            <td class="left">Advance</td>
            <td>₹ {{advance}}</td>
          </tr>
          <tr class="total-row">
            <td class="left">Balance</td>
            <td>₹ {{balance}}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- SIGNATURE BLOCK -->
  <div class="footer-row">
    <div style="width: 50%;"></div>
    <div class="footer-company-col">
      <p class="for-company">For : {{companyName}}</p>
      <div class="signature-wrap">
        {{#if signatureUrl}}
        <img src="{{signatureUrl}}" alt="Signature Stamp" />
        {{/if}}
      </div>
      <p style="font-weight: bold; font-size: 9.5px; margin-top: 4px;">Authorized Signatory</p>
    </div>
  </div>

</body>

</html>