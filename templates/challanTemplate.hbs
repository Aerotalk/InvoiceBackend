<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Delivery Challan</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: Arial, sans-serif;
      font-size: 10px;
      color: #000;
      background: #fff;
      padding: 10px 15px;
      line-height: 1.3;
    }

    /* ── HEADER ── */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 8px;
      padding-bottom: 8px;
    }
    .header-logo img {
      max-width: 140px;
      max-height: 80px;
      object-fit: contain;
    }
    .header-company {
      text-align: right;
      max-width: 65%;
    }
    .header-company h1 {
      font-size: 13.5px;
      font-weight: bold;
      text-transform: uppercase;
      margin-bottom: 3px;
      letter-spacing: 0.5px;
    }
    .header-company p {
      font-size: 9px;
      line-height: 1.3;
      color: #111;
    }

    /* ── DOC TITLE BAR ── */
    .doc-title-bar {
      text-align: center;
      background: #f4f4f5;
      border-top: 1px solid #ccc;
      border-bottom: 1px solid #ccc;
      padding: 4px 0;
      margin-bottom: 12px;
    }
    .doc-title-bar span {
      font-size: 12px;
      font-weight: bold;
      color: #555;
    }

    /* ── INFO SECTION (4 COLUMNS) ── */
    .info-section {
      display: flex;
      justify-content: space-between;
      margin-bottom: 12px;
      gap: 12px;
    }
    .info-col {
      width: 25%;
    }
    .col-title {
      font-size: 10px;
      font-weight: bold;
      color: #000;
      border-bottom: 1px solid #ccc;
      padding-bottom: 3px;
      margin-bottom: 5px;
    }
    .col-company {
      font-weight: bold;
      font-size: 9.5px;
      margin-bottom: 3px;
      text-transform: uppercase;
    }
    .col-text {
      font-size: 9px;
      line-height: 1.35;
      color: #222;
    }
    .col-text strong {
      font-weight: bold;
      color: #000;
    }

    /* ── CHALLAN DETAILS TABLE ── */
    .challan-details-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9px;
    }
    .challan-details-table td {
      padding: 1.5px 0;
      vertical-align: top;
      line-height: 1.25;
    }
    .challan-details-table td.lbl {
      text-align: right;
      padding-right: 4px;
      color: #222;
      width: 45%;
    }
    .challan-details-table td.val {
      text-align: right;
      font-weight: bold;
      color: #000;
      width: 55%;
    }

    /* ── ITEMS TABLE ── */
    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12px;
      font-size: 9.5px;
    }
    .items-table th {
      background: #8e99a7;
      color: #fff;
      border: 1px solid #7c8ba1;
      padding: 4px 6px;
      font-weight: bold;
      font-size: 9px;
      text-align: center;
    }
    .items-table th.left { text-align: left; }
    .items-table td {
      border: 1px solid #ccc;
      padding: 5px 6px;
      vertical-align: top;
      line-height: 1.3;
    }
    .items-table td.num { text-align: center; width: 30px; }
    .items-table td.center { text-align: center; }
    .items-table td.right { text-align: right; }
    .items-table tr.total-row td {
      font-weight: bold;
      border-top: 1.5px solid #000;
      border-bottom: 1.5px solid #000;
      background: #fff;
    }

    /* ── TERMS & CONDITIONS ── */
    .terms-section {
      margin-top: 8px;
      margin-bottom: 12px;
    }
    .terms-header {
      background: #9ca3af;
      color: #fff;
      padding: 3px 6px;
      font-weight: bold;
      font-size: 9px;
      margin-bottom: 4px;
      text-transform: uppercase;
    }
    .terms-content {
      font-size: 9px;
      line-height: 1.3;
      padding-left: 2px;
    }

    /* ── FOOTER ROW ── */
    .footer-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-top: 10px;
    }
    .footer-col {
      width: 32%;
    }
    .footer-col-header {
      background: #9ca3af;
      color: #fff;
      padding: 3px 6px;
      font-weight: bold;
      font-size: 9px;
      margin-bottom: 6px;
      text-transform: uppercase;
    }
    .footer-col-body {
      font-size: 9px;
      line-height: 1.5;
      color: #000;
    }
    .footer-col-body div {
      margin-bottom: 1px;
    }
    .footer-company-col {
      width: 32%;
      text-align: right;
    }
    .for-company {
      font-size: 9.5px;
      font-weight: bold;
      margin-bottom: 4px;
    }
    .signature-wrap {
      height: 60px;
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
      margin-bottom: 4px;
    }
    .signature-wrap img {
      max-height: 55px;
      max-width: 130px;
      object-fit: contain;
    }
  </style>
</head>
<body>

  <!-- HEADER -->
  <div class="header">
    <div class="header-logo">
      {{#if logoUrl}}
        <img src="{{logoUrl}}" alt="Company Logo" />
      {{/if}}
    </div>
    <div class="header-company">
      <h1>{{companyName}}</h1>
      <p>{{companyAddress}}</p>
      <p>Phone no.: {{companyPhone}} Email: {{companyEmail}}</p>
      <p>GSTIN: {{companyGstin}}, State: {{companyState}}</p>
      <p>PAN: {{companyPan}}</p>
    </div>
  </div>

  <!-- TITLE BAR -->
  <div class="doc-title-bar">
    <span>Delivery Challan</span>
  </div>

  <!-- DETAILS GRID -->
  <div class="info-section">
    <!-- Col 1 -->
    <div class="info-col">
      <div class="col-title">Delivery Challan For</div>
      <div class="col-company">{{clientCompanySnapshot}}</div>
      <div class="col-text">
        {{customer.billingStreet1}}{{#if customer.billingStreet2}}, {{customer.billingStreet2}}{{/if}}
        <br/>{{customer.billingCity}}{{#if customer.billingState}}, {{customer.billingState}}{{/if}}{{#if customer.billingZipCode}} - {{customer.billingZipCode}}{{/if}}
        {{#if customer.billingCountry}}<br/>{{customer.billingCountry}}{{/if}}
        <br/><strong>GSTIN :</strong> {{customer.gstNumber}}
        <br/><strong>State:</strong> {{customer.billingState}}
      </div>
    </div>
    <!-- Col 2 -->
    <div class="info-col">
      <div class="col-title">Ship To</div>
      <div class="col-company">{{clientCompanySnapshot}}</div>
      <div class="col-text">
        {{#if customer.shippingStreet1}}
          {{customer.shippingStreet1}}{{#if customer.shippingStreet2}}, {{customer.shippingStreet2}}{{/if}}
          <br/>{{customer.shippingCity}}{{#if customer.shippingState}}, {{customer.shippingState}}{{/if}}{{#if customer.shippingZipCode}} - {{customer.shippingZipCode}}{{/if}}
          {{#if customer.shippingCountry}}<br/>{{customer.shippingCountry}}{{/if}}
        {{else}}
          {{customer.billingStreet1}}{{#if customer.billingStreet2}}, {{customer.billingStreet2}}{{/if}}
          <br/>{{customer.billingCity}}{{#if customer.billingState}}, {{customer.billingState}}{{/if}}{{#if customer.billingZipCode}} - {{customer.billingZipCode}}{{/if}}
          {{#if customer.billingCountry}}<br/>{{customer.billingCountry}}{{/if}}
        {{/if}}
      </div>
    </div>
    <!-- Col 3 -->
    <div class="info-col">
      <div class="col-title">Transportation Details</div>
      <div class="col-text">
        <strong>Transport Mode:</strong> {{transportMode}}
        <br/><strong>Delivery Location:</strong> {{deliveryLocation}}
        <br/><strong style="display:inline-block; margin-top: 4px;">EU PO/WO Number:</strong> {{#if euPoWoNumber}}{{euPoWoNumber}}{{else}}{{referenceNumber}}{{/if}}
      </div>
    </div>
    <!-- Col 4 -->
    <div class="info-col">
      <div class="col-title">Challan Details</div>
      <table class="challan-details-table">
        <tr>
          <td class="lbl">Challan No. :</td>
          <td class="val">{{challanNumber}}</td>
        </tr>
        <tr>
          <td class="lbl">Date :</td>
          <td class="val">{{challanDate}}</td>
        </tr>
        <tr>
          <td class="lbl">Place of supply:</td>
          <td class="val">{{customer.billingState}}</td>
        </tr>
        <tr>
          <td class="lbl" style="padding-top: 4px;">Name:</td>
          <td class="val" style="padding-top: 4px;">{{contactName}}</td>
        </tr>
        <tr>
          <td class="lbl">Email:</td>
          <td class="val" style="word-break: break-all; font-weight: normal; font-size: 8.5px;">{{contactEmail}}</td>
        </tr>
        <tr>
          <td class="lbl">Mobile:</td>
          <td class="val">{{contactPhone}}</td>
        </tr>
      </table>
    </div>
  </div>

  <!-- ITEMS TABLE -->
  <table class="items-table">
    <thead>
      <tr>
        <th style="width: 35px;">#</th>
        <th class="left">Item name</th>
        <th style="width: 100px;">HSN/ SAC</th>
        <th style="width: 80px;">Quantity</th>
        <th style="width: 80px;">Unit</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td class="num">{{index}}</td>
        <td>
          <strong>{{name}}</strong>
          {{#if description}}
            <br/><span style="color:#333; font-size: 8.5px; font-weight: normal; line-height: 1.25; display: inline-block; margin-top: 2px;">{{description}}</span>
          {{/if}}
        </td>
        <td class="center">{{hsn}}</td>
        <td class="center">{{quantity}}</td>
        <td class="center">{{unit}}</td>
      </tr>
      {{/each}}
      <tr class="total-row">
        <td colspan="3">Total</td>
        <td class="center">{{totalQuantity}}</td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <!-- TERMS AND CONDITIONS -->
  <div class="terms-section">
    <div class="terms-header">Terms and Conditions</div>
    <div class="terms-content">
      <p>Thanks for doing business with us!</p>
      {{#if termsConditions}}
        <p style="white-space: pre-wrap; margin-top: 3px; font-size: 8.5px; color: #333;">{{termsConditions}}</p>
      {{/if}}
    </div>
  </div>

  <!-- THREE COLUMN FOOTER -->
  <div class="footer-row">
    <!-- Received By -->
    <div class="footer-col">
      <div class="footer-col-header">Received By</div>
      <div class="footer-col-body">
        <div>Name:</div>
        <div style="margin-top: 3px;">Comment:</div>
        <div style="margin-top: 3px;">Date:</div>
        <div style="margin-top: 3px;">Signature:</div>
      </div>
    </div>
    <!-- Delivered By -->
    <div class="footer-col">
      <div class="footer-col-header">Delivered By</div>
      <div class="footer-col-body">
        <div>Name:</div>
        <div style="margin-top: 3px;">Comment:</div>
        <div style="margin-top: 3px;">Date:</div>
        <div style="margin-top: 3px;">Signature:</div>
      </div>
    </div>
    <!-- For Company (Right Signature) -->
    <div class="footer-company-col">
      <p class="for-company">For : {{companyName}}</p>
      <div class="signature-wrap">
        {{#if signatureUrl}}
          <img src="{{signatureUrl}}" alt="Signature Stamp" />
        {{/if}}
      </div>
    </div>
  </div>

</body>
</html>
